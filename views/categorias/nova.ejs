<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Abrir seção — Livro-Caixa</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
  <header class="topo">
    <div class="topo-inner">
      <a class="marca" href="/">Livro-Caixa<small>controle de estoque da loja</small></a>
      <nav>
        <a href="/">Início</a>
        <a href="/produtos">Produtos</a>
        <a href="/categorias" aria-current="page">Categorias</a>
      </nav>
    </div>
  </header>
  <main class="pagina">
    <h1>Abrir seção</h1>
    <p class="sub">Uma seção nova para agrupar produtos da mesma prateleira.</p>

    <% if (erro) { %>
      <p class="erro" role="alert">
        <%= erro %>
      </p>
      <% } %>

        <form class="form-livro" action="/categorias" method="POST" data-flash="Seção aberta"
          data-flash-texto="A nova seção entrou para o livro.">
          <label>Nome da seção
            <input type="text" name="nome" required autocomplete="off" placeholder="Ex.: Informática">
          </label>
          <div class="linha">
            <button class="btn" type="submit">Abrir seção</button>
            <a class="btn secundario" href="/categorias">Voltar</a>
          </div>
        </form>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/javascripts/app.js"></script>
</body>

</html>